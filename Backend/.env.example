# Amazon RDS Database Configuration
# Supported RDS_DIALECT: postgres (PostgreSQL / Aurora PG) or mysql (MySQL / Aurora MySQL)
RDS_DIALECT=postgres
RDS_HOST=database-1.cluster-crk8ake8kxgn.ap-southeast-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=postgres
RDS_USER=postgres
RDS_PASSWORD=your_rds_password_here

# Name of your database table containing drug data
RDS_TABLE_NAME=drug_products

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0
